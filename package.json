{
  "name": "obsidian-open-agent",
  "version": "0.1.1",
  "description": "Vault-aware AI agent with tools and your own API keys.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && node deploy.mjs",
    "lint": "eslint --ext .ts --no-error-on-unmatched-pattern src tests hackathon/eval vitest.config.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx hackathon/eval/run.ts"
  },
  "keywords": [
    "obsidian-plugin",
    "ai",
    "agent",
    "mcp"
  ],
  "files": [
    "main.js",
    "styles.css",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "author": "nikitaclicks",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "obsidian": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
